# Configuration RadioPlatform - Module 1 (SIH / RIS)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-in-production-secret-key-12345
DATABASE_URL=postgres://radio_user:radio_password@localhost:5432/radio_db

# Base de données PostgreSQL Docker
POSTGRES_DB=radio_db
POSTGRES_USER=radio_user
POSTGRES_PASSWORD=radio_password
POSTGRES_PORT=5432

# Ports hôte
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Module 2 — Orthanc PACS
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=orthanc
ORTHANC_PASS=orthanc
ORTHANC_AET=ORTHANC
ORTHANC_DICOM_PORT=4242

# Module 2 — OHIF Viewer
OHIF_PORT=3001
